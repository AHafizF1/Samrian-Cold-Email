{
  "name": "samrian",
  "version": "0.1.0",
  "description": "Self-hostable cold email outreach platform",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.3.2",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --project db",
    "test:security": "vitest run --project security",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "crypto:rotate": "bun scripts/crypto/rotate.ts",
    "data:audit": "bun scripts/data/audit.ts",
    "db:test:up": "docker compose -f docker-compose.db.yml up -d",
    "storage:test:up": "docker compose -f docker-compose.storage.yml up -d",
    "queue:test:up": "docker compose -f docker-compose.worker.yml up -d redis",
    "worker": "bun src/server/worker/run.ts",
    "inngest:dev": "docker compose -f docker-compose.yml -f docker-compose.inngest.yml up -d dev-app inngest",
    "ops:betterstack": "bun scripts/betterstack.ts",
    "ops:betterstack:apply": "bun scripts/betterstack.ts --apply",
    "smoke": "bun scripts/smoke.ts",
    "cli:build": "bun build packages/cli/src/bin.ts --outdir dist/cli --target bun",
    "cli:smoke": "bun packages/cli/src/bin.ts --help",
    "mcp:build": "bun build packages/mcp/src/server.ts packages/mcp/src/stdio.ts --outdir packages/mcp/dist --target bun",
    "mcp:smoke": "bun run test --project scripts -- tests/scripts/mcp.test.ts",
    "security:seed": "bun scripts/security/seed.ts",
    "security:semgrep": "bun scripts/security/run.ts semgrep",
    "security:gitleaks": "bun scripts/security/run.ts gitleaks",
    "security:trivy": "bun scripts/security/run.ts trivy",
    "security:schemathesis": "bun scripts/security/run.ts schemathesis",
    "security:audit": "bun scripts/security/run.ts audit",
    "validate": "bun run type-check && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@base-ui/react": "^1.7.0",
    "@better-auth/api-key": "1.6.27",
    "@better-auth/drizzle-adapter": "1.6.27",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@samrian/contracts": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/node": "^10.9.0",
    "better-auth": "1.6.27",
    "bullmq": "^5.81.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "imapflow": "1.7.0",
    "inngest": "4.18.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.0",
    "nodemailer": "9.0.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.8.1",
    "jsdom": "^29.1.1",
    "prettier": "3.9.4",
    "shadcn": "4.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
