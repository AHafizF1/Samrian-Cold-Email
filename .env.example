# ===== Auth Provider =====
# OSS/self-host default: better-auth. SaaS/enterprise option: workos.
AUTH_PROVIDER="better-auth"
NEXT_PUBLIC_AUTH_PROVIDER="better-auth"

# ===== Production Required Secrets =====
BETTER_AUTH_SECRET=""
# Active key ID is metadata. Keyring is secret JSON: {"2026-01":"64 hex characters"}.
# Keep old keys during rotation. MASTER_ENCRYPTION_KEY is legacy decrypt-only migration input.
CREDENTIAL_ACTIVE_KEY_ID=""
CREDENTIAL_KEYS_JSON=""
MASTER_ENCRYPTION_KEY=""
UNSUBSCRIBE_SECRET=""

# Your local site URL (used for OAuth redirects and cookie domains)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public corresponding-source URL for this deployed revision. Required for hosted AGPL deployments.
NEXT_PUBLIC_SOURCE_URL=""

# ===== WorkOS AuthKit (required only when AUTH_PROVIDER=workos) =====
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""
WORKOS_COOKIE_PASSWORD=""
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/api/auth/workos/callback"

# ===== User Auth: Google (Better Auth only) =====
# Google redirect URI: http://localhost:3000/api/auth/callback/google
# Set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true only when both values are configured.
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# WorkOS mode uses Google configured in WorkOS Dashboard/AuthKit, not these values.

# ===== Mailbox OAuth (Google Workspace + Microsoft 365) =====
# Separate from user login Google OAuth above.
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Get from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional: defaults to "common" for multi-tenant
# MICROSOFT_TENANT_ID=""

# ===== Inngest Settings (for Next.js) =====
# For local dev, these can remain empty or "local"
# For production, get these from the Inngest Dashboard
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"
# Local SDK v4 development only. `bun run inngest:dev` sets both values in Docker.
INNGEST_DEV="0"
INNGEST_BASE_URL="http://localhost:8288"

# ===== PostgreSQL / Drizzle =====
# Local Docker defaults from docker-compose.db.yml
DATABASE_DRIVER="postgres-js"
# Migration-owner credential. Use only for db:generate/db:migrate and admin setup.
# Do not expose this URL to the running app or worker in production.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/samrian"
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/samrian_test"
TEST_APP_DATABASE_URL="postgres://samrian_app_runtime:samrian-app-local@localhost:5432/samrian_test"
TEST_AUTH_DATABASE_URL="postgres://samrian_auth_runtime:samrian-auth-local@localhost:5432/samrian_test"
TEST_WORKER_DATABASE_URL="postgres://samrian_worker_runtime:samrian-worker-local@localhost:5432/samrian_test"

# Runtime URLs use separate PostgreSQL login accounts:
# - samrian_app_runtime inherits samrian_app: RLS-protected product tables.
# - samrian_auth_runtime inherits samrian_auth: Better Auth tables only.
# - samrian_worker_runtime inherits samrian_worker: background-job capabilities.
# AUTH_DATABASE_URL is required only when AUTH_PROVIDER=better-auth. WorkOS owns
# its auth data and intentionally never opens this connection.
APP_DATABASE_URL="postgres://samrian_app_runtime:change-me@localhost:5432/samrian"
AUTH_DATABASE_URL="postgres://samrian_auth_runtime:change-me@localhost:5432/samrian"
WORKER_DATABASE_URL="postgres://samrian_worker_runtime:change-me@localhost:5432/samrian"

# Optional pooled runtime URLs for Neon/Supabase. Runtime uses these before the
# matching direct URL. Keep DATABASE_URL direct for schema migrations.
DATABASE_POOL_URL=""
APP_DATABASE_POOL_URL=""
AUTH_DATABASE_POOL_URL=""
WORKER_DATABASE_POOL_URL=""

# Docker bootstrap passwords create login accounts; these names are not app env
# identities or product roles. Use distinct generated secrets in production.
SAMRIAN_APP_DB_PASSWORD="change-me"
SAMRIAN_AUTH_DB_PASSWORD="change-me"
SAMRIAN_WORKER_DB_PASSWORD="change-me"

# ===== Observability / Better Stack =====
# Local OSS mode can stay "none". Production can use "betterstack".
OBSERVABILITY_PROVIDER="none"
OTEL_SERVICE_NAME="samrian-app"
OTEL_SERVICE_VERSION="dev"
OTEL_DEPLOYMENT_ENVIRONMENT="development"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
BETTER_STACK_SOURCE_TOKEN=""
BETTER_STACK_INGESTING_HOST=""
BETTER_STACK_UPTIME_TOKEN=""
BETTER_STACK_TEAM_NAME=""
BETTER_STACK_STATUS_PAGE_ID=""
BETTER_STACK_REGION=""

# ===== S3-Compatible Object Storage =====
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, and other compatible providers.
STORAGE_PROVIDER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="samrian"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio-password"
S3_FORCE_PATH_STYLE="true"
# AWS S3 defaults to encryption, but compatible providers differ. Set explicitly in production.
S3_SERVER_SIDE_ENCRYPTION="AES256"
# Required only when S3_SERVER_SIDE_ENCRYPTION=aws:kms.
S3_KMS_KEY_ID=""

# Optional integration-test storage env. Defaults match docker-compose.storage.yml.
TEST_S3_ENDPOINT="http://localhost:9000"
TEST_S3_REGION="us-east-1"
TEST_S3_BUCKET="samrian"
TEST_S3_ACCESS_KEY_ID="minio"
TEST_S3_SECRET_ACCESS_KEY="minio-password"
TEST_S3_FORCE_PATH_STYLE="true"

# ===== Optional Email Verification =====
# If unset, imports keep verification_status empty and allow unknown contacts.
EMAIL_VERIFIER_URL=""
EMAIL_VERIFIER_API_KEY=""
EMAIL_VERIFIER_PROVIDER="http"

# ===== Jobs / Queue Runtime =====
# Managed/serverless mode should use Inngest. Docker/VPS mode can use BullMQ + Redis.
JOB_PROVIDER="inngest"
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY="5"
JOB_DEFAULT_ATTEMPTS="3"
BULLMQ_PREFIX="samrian"

# ===== Rate Limits =====
# Local default: off + memory. Production default: enforce + Redis.
# Hosted deployments set tier from trusted deployment/billing config, never request input.
RATE_LIMIT_MODE="off"
RATE_LIMIT_PROVIDER="memory"
RATE_LIMIT_TIER="self-hosted"
RATE_LIMIT_REDIS_PREFIX="samrian:limits"
# Emergency reduction only: >0 and <=1. Normal value is 1.
RATE_LIMIT_EMERGENCY_MULTIPLIER="1"
# Enforced production requires single. One trusted reverse proxy must overwrite X-Forwarded-For.
# Never preserve or append a client-supplied X-Forwarded-For value.
TRUSTED_PROXY_MODE="none"

# ===== Outbound SMTP / IMAP Network Policy =====
# Default false blocks private, loopback, link-local, metadata, multicast, and reserved targets.
# Enable only for a trusted self-hosted mail server on a deployment-controlled private network.
# Tenant/API input cannot override this deployment-level switch.
OUTBOUND_ALLOW_PRIVATE_EMAIL_HOSTS="false"

# ===== Automation API / CLI =====
# API keys are organization-owned and created through authenticated settings routes.
# Do not put a real key in this file, URLs, CLI arguments, or committed config.
SAMRIAN_URL="http://localhost:3000"
SAMRIAN_TOKEN=""

# ===== MCP Server =====
# read-only is default. operator adds approved draft-safe writes but never bypasses token scopes.
MCP_MODE="read-only"

# ===== Disposable Security Scans =====
# Never point authenticated or active scans at production.
SECURITY_BASE_URL="http://host.docker.internal:3100"
SECURITY_ENVIRONMENT="local-security"
SECURITY_AUTH_PROVIDER="better-auth"
SECURITY_AUTH_EMAIL=""
SECURITY_AUTH_PASSWORD=""
SECURITY_APP_URL="http://localhost:3100"
# Required by security:seed. DATABASE_URL must also contain "security".
SECURITY_DISPOSABLE=""

# Optional integration-test queue env. Default matches docker-compose.worker.yml.
TEST_REDIS_URL="redis://localhost:6379"
