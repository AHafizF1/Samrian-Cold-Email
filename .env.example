# ===== Convex =====
# These are set automatically when you run `bunx convex dev`
CONVEX_DEPLOYMENT=""
NEXT_PUBLIC_CONVEX_URL=""

# Same as NEXT_PUBLIC_CONVEX_URL but ends in .site
NEXT_PUBLIC_CONVEX_SITE_URL=""

# Your local site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Convex Environment Variables (set via `bunx convex env set`) =====
# BETTER_AUTH_SECRET=<generated-secret>
# SITE_URL=http://localhost:3000
# MASTER_ENCRYPTION_KEY=<32-byte-hex-string> - Required for mailbox credential encryption
# UNSUBSCRIBE_SECRET=<secure-random-string>  - 🔴 CRITICAL: Without this, unsubscribe tokens are trivially spoofable!

# ===== Inngest Settings (for Next.js) =====
# For local dev, these can remain empty or "local"
# For production, get these from the Inngest Dashboard
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"
